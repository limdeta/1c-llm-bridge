Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.Хозрасчетный.Записывать = Истина;

	Для Каждого Стр Из Товары Цикл

		Если Не ЗначениеЗаполнено(Стр.Товар) Или Стр.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Списание со склада
		ДвОстатки = Движения.ОстаткиТоваров.Добавить();
		ДвОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвОстатки.Период = Дата;
		ДвОстатки.Товар = Стр.Товар;
		ДвОстатки.Количество = Стр.Количество;

		// Оборот продажи: выручка и себестоимость
		ДвПродажи = Движения.Продажи.Добавить();
		ДвПродажи.Период = Дата;
		ДвПродажи.Товар = Стр.Товар;
		ДвПродажи.Количество = Стр.Количество;
		ДвПродажи.Сумма = Стр.Сумма;
		ДвПродажи.Себестоимость = Стр.Товар.ЦенаЗакупки * Стр.Количество;

		// Бухгалтерская проводка: Дт 62 (Расчеты с покупателями) Кт 90.01 (Выручка)
		ДвБух = Движения.Хозрасчетный.Добавить();
		ДвБух.Период = Дата;
		ДвБух.СчетДт = ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
		ДвБух.СчетКт = ПланыСчетов.Хозрасчетный.Выручка;
		ДвБух.СуммаДт = Стр.Сумма;
		ДвБух.СуммаКт = Стр.Сумма;

		// Себестоимость: Дт 90.02 (Себестоимость продаж) Кт 41 (Товары)
		ДвБух2 = Движения.Хозрасчетный.Добавить();
		ДвБух2.Период = Дата;
		ДвБух2.СчетДт = ПланыСчетов.Хозрасчетный.СебестоимостьПродаж;
		ДвБух2.СчетКт = ПланыСчетов.Хозрасчетный.Товары;
		ДвБух2.СуммаДт = Стр.Товар.ЦенаЗакупки * Стр.Количество;
		ДвБух2.СуммаКт = Стр.Товар.ЦенаЗакупки * Стр.Количество;

	КонецЦикла;

КонецПроцедуры
